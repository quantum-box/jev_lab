    "@vitejs/plugin-react": "^6.0.3",
    "@vitejs/plugin-rsc": "^0.5.26",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.7",
    "react-server-dom-webpack": "19.2.6",
